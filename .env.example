# Copy this file to .env and adjust to match YOUR local PostgreSQL / pgAdmin setup.
# These are the same connection details you use to open swiftdrive_vrms in pgAdmin.

PGHOST=localhost
PGPORT=5432
PGDATABASE=swiftdrive_vrms
PGUSER=postgres
PGPASSWORD=your_postgres_password_here

# Port the VRMS web app itself will run on (open http://localhost:3000 after starting)
PORT=3000
