<div class="page-header">
  <div>
    <h1><%= t('customers.new.title') %></h1>
    <p class="subtitle"><%= t('customers.new.subtitle') %></p>
  </div>
</div>

<div class="card">
  <% if (error) { %><div class="flash error" role="alert"><%= error %></div><% } %>

  <form class="stack" method="POST" action="/customers">
    <p class="hint"><%= t('customers.new.allRequired') %></p>

    <fieldset class="field choice">
      <legend><%= t('customers.new.customerType') %></legend>
      <div class="form-row">
        <label class="field inline"><input type="radio" name="customerType" value="Individual" <%= form.customerType !== 'Corporate' ? 'checked' : '' %>> <%= t('common.individual') %></label>
        <label class="field inline"><input type="radio" name="customerType" value="Corporate" <%= form.customerType === 'Corporate' ? 'checked' : '' %>> <%= t('common.corporate') %></label>
      </div>
    </fieldset>

    <div class="form-row">
      <div class="field">
        <label for="email"><%= t('customers.new.email') %></label>
        <input type="email" id="email" name="email" required autocomplete="email" value="<%= form.email || '' %>">
      </div>
      <div class="field">
        <label for="phone"><%= t('customers.new.phone') %></label>
        <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="+264 81 000 0000" value="<%= form.phone || '' %>">
      </div>
    </div>
    <div class="field">
      <label for="addressLine"><%= t('customers.new.address') %></label>
      <input type="text" id="addressLine" name="addressLine" required autocomplete="street-address" value="<%= form.addressLine || '' %>">
    </div>

    <div id="individualFields" class="type-fields">
      <div class="form-row">
        <div class="field">
          <label for="firstName"><%= t('customers.new.firstName') %></label>
          <input type="text" id="firstName" name="firstName" required autocomplete="given-name" value="<%= form.firstName || '' %>">
        </div>
        <div class="field">
          <label for="lastName"><%= t('customers.new.lastName') %></label>
          <input type="text" id="lastName" name="lastName" required autocomplete="family-name" value="<%= form.lastName || '' %>">
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="licenseNumber"><%= t('customers.new.licenseNumber') %></label>
          <input type="text" id="licenseNumber" name="licenseNumber" required value="<%= form.licenseNumber || '' %>">
        </div>
        <div class="field">
          <label for="licenseExpiry"><%= t('customers.new.licenseExpiry') %></label>
          <input type="date" id="licenseExpiry" name="licenseExpiry" required value="<%= form.licenseExpiry || '' %>">
        </div>
        <div class="field">
          <label for="dateOfBirth"><%= t('customers.new.dateOfBirth') %></label>
          <input type="date" id="dateOfBirth" name="dateOfBirth" required autocomplete="bday" aria-describedby="dobHint" value="<%= form.dateOfBirth || '' %>">
          <div class="hint" id="dobHint"><%= t('customers.new.hintAge18') %></div>
        </div>
      </div>
    </div>

    <div id="corporateFields" class="type-fields">
      <div class="form-row">
        <div class="field">
          <label for="companyName"><%= t('customers.new.companyName') %></label>
          <input type="text" id="companyName" name="companyName" required autocomplete="organization" value="<%= form.companyName || '' %>">
        </div>
        <div class="field">
          <label for="companyRegNumber"><%= t('customers.new.companyRegNumber') %></label>
          <input type="text" id="companyRegNumber" name="companyRegNumber" required value="<%= form.companyRegNumber || '' %>">
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="contactPersonName"><%= t('customers.new.contactPerson') %></label>
          <input type="text" id="contactPersonName" name="contactPersonName" required autocomplete="name" value="<%= form.contactPersonName || '' %>">
        </div>
        <div class="field">
          <label for="creditLimit"><%= t('customers.new.creditLimit') %></label>
          <input type="number" id="creditLimit" name="creditLimit" required step="0.01" min="0" inputmode="decimal" value="<%= form.creditLimit || '0' %>">
        </div>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn"><%= t('customers.new.save') %></button>
      <a href="/customers" class="btn ghost"><%= t('common.cancel') %></a>
    </div>
  </form>
</div>

<script>
  // Only the fields of the selected customer type are shown, required and submitted.
  (function () {
    var groups = { Individual: document.getElementById('individualFields'), Corporate: document.getElementById('corporateFields') };
    function sync() {
      var type = document.querySelector('input[name="customerType"]:checked').value;
      Object.keys(groups).forEach(function (k) {
        var on = k === type;
        groups[k].hidden = !on;
        groups[k].querySelectorAll('input').forEach(function (input) { input.disabled = !on; });
      });
    }
    document.querySelectorAll('input[name="customerType"]').forEach(function (r) { r.addEventListener('change', sync); });
    sync();
  })();
</script>
