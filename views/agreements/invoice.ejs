<div class="page-header">
  <div>
    <h1><%= t('agreements.invoice.title', { id: agreement.agreementid }) %></h1>
    <p class="subtitle"><%= t('common.customerVehicle', { customer: agreement.customername, vehicle: agreement.registrationnumber }) %></p>
  </div>
</div>

<% if (error) { %><div class="flash error" role="alert"><%= error %></div><% } %>

<% if (!invoice) { %>
  <div class="card">
    <% if (!agreement.actualreturndate) { %>
      <div class="empty">
        <p><%= t('agreements.invoice.mustReturnFirst') %></p>
        <a href="/agreements/<%= agreement.agreementid %>/return" class="btn"><%= t('agreements.invoice.processReturnFirst') %></a>
      </div>
    <% } else { %>
      <div class="empty">
        <p><%= t('agreements.invoice.noneYet') %></p>
        <form method="POST" action="/agreements/<%= agreement.agreementid %>/invoice/generate">
          <button type="submit" class="btn"><%= t('agreements.invoice.generate') %></button>
        </form>
      </div>
    <% } %>
  </div>
<% } else { const balance = Number(invoice.totalamount) - Number(invoice.amountpaid); %>
  <div class="grid cols-2">
    <div class="card">
      <h2><%= t('agreements.invoice.header', { id: invoice.invoiceid }) %></h2>
      <dl class="kv">
        <dt><%= t('agreements.invoice.date') %></dt><dd><%= new Date(invoice.invoicedate).toLocaleDateString(dateLocale) %></dd>
        <dt><%= t('agreements.invoice.total') %></dt><dd class="num"><%= fmtMoney(invoice.totalamount) %></dd>
        <dt><%= t('agreements.invoice.paid') %></dt><dd class="num"><%= fmtMoney(invoice.amountpaid) %></dd>
        <dt><%= t('agreements.invoice.balance') %></dt><dd class="num"><strong><%= fmtMoney(balance) %></strong></dd>
        <dt><%= t('agreements.invoice.status') %></dt><dd>
          <% const ic = { Paid: 'green', PartiallyPaid: 'amber', Unpaid: 'red' }[invoice.invoicestatus] || 'grey'; %>
          <span class="badge <%= ic %>"><%= statusLabel('invoice', invoice.invoicestatus) %></span>
        </dd>
      </dl>

      <h2 style="margin-top:20px;"><%= t('agreements.invoice.details') %></h2>
      <table>
        <thead><tr><th><%= t('agreements.invoice.colDescription') %></th><th class="right"><%= t('agreements.invoice.colAmount') %></th></tr></thead>
        <tbody>
          <% lines.forEach(l => { %>
            <tr><td><%= l.description %></td><td class="right"><%= fmtMoney(l.amount) %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="card">
      <h2><%= t('agreements.invoice.payments') %></h2>
      <% if (payments.length === 0) { %>
        <p class="empty"><%= t('agreements.invoice.noPayments') %></p>
      <% } else { %>
      <table>
        <thead><tr><th><%= t('agreements.invoice.date') %></th><th><%= t('agreements.invoice.colType') %></th><th><%= t('agreements.invoice.colMethod') %></th><th class="right"><%= t('agreements.invoice.colAmount') %></th></tr></thead>
        <tbody>
          <% payments.forEach(p => { %>
            <tr>
              <td><%= new Date(p.paymentdate).toLocaleDateString(dateLocale) %></td>
              <td><%= statusLabel('paymenttype', p.paymenttype) %></td>
              <td><%= statusLabel('paymentmethod', p.paymentmethod) %></td>
              <td class="right"><%= fmtMoney(p.amount) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>

      <% if (invoice.invoicestatus !== 'Paid') { %>
      <h2 style="margin-top:20px;"><%= t('agreements.invoice.recordPayment') %></h2>
      <form class="stack" method="POST" action="/agreements/<%= agreement.agreementid %>/payment">
        <div class="form-row">
          <div class="field">
            <label for="amount"><%= t('agreements.invoice.amount') %></label>
            <input type="number" id="amount" step="0.01" min="0.01" inputmode="decimal" name="amount" required value="<%= balance > 0 ? balance.toFixed(2) : '' %>" aria-describedby="amountHint">
            <div class="hint" id="amountHint"><%= t('agreements.invoice.amountHint', { amount: fmtMoney(balance) }) %></div>
          </div>
          <div class="field">
            <label for="method"><%= t('agreements.invoice.method') %></label>
            <select id="method" name="method" required>
              <% ['Cash', 'Card', 'EFT'].forEach((m) => { %><option value="<%= m %>"><%= statusLabel('paymentmethod', m) %></option><% }) %>
            </select>
          </div>
          <div class="field">
            <label for="type"><%= t('agreements.invoice.type') %></label>
            <select id="type" name="type" required>
              <% ['RentalFee', 'Penalty', 'Deposit'].forEach((ty) => { %><option value="<%= ty %>"><%= statusLabel('paymenttype', ty) %></option><% }) %>
            </select>
          </div>
        </div>
        <div class="form-actions"><button type="submit" class="btn"><%= t('agreements.invoice.recordBtn') %></button></div>
      </form>
      <% } %>
    </div>
  </div>
<% } %>
