<div class="page-header">
  <div>
    <h1><%= t('dashboard.title') %></h1>
    <p class="subtitle"><%= t('dashboard.subtitle') %></p>
  </div>
  <a href="/bookings/new" class="btn"><%= t('dashboard.newBooking') %></a>
</div>

<div class="grid cols-4">
  <div class="stat">
    <div class="value"><%= todayCount %></div>
    <div class="label"><%= t('dashboard.statToday') %></div>
  </div>
  <div class="stat">
    <div class="value"><%= fmtPct(Number(utilization) / 100) %></div>
    <div class="label"><%= t('dashboard.statUtilization', { rented: fleet.rented, total: fleet.total }) %></div>
  </div>
  <div class="stat">
    <div class="value"><%= overdueCount %></div>
    <div class="label"><%= t('dashboard.statOverdue') %></div>
    <% if (overdueCount > 0) { %><a class="caption-link" href="/agreements"><%= t('dashboard.overdueAction') %></a><% } %>
  </div>
  <div class="stat">
    <div class="value"><%= fmtMoney(outstanding) %></div>
    <div class="label"><%= t('dashboard.statOutstanding') %></div>
  </div>
</div>

<div class="grid cols-2">
  <div class="card">
    <h2><%= t('dashboard.quickActions') %></h2>
    <div class="action-list">
      <a href="/customers/new" class="btn secondary"><%= t('dashboard.actionRegisterCustomer') %></a>
      <a href="/bookings/new" class="btn"><%= t('dashboard.actionCreateBooking') %></a>
      <a href="/bookings" class="btn ghost"><%= t('dashboard.actionConfirmAssign') %></a>
      <a href="/agreements" class="btn ghost"><%= t('dashboard.actionProcessReturn') %></a>
    </div>
  </div>
  <div class="card">
    <h2><%= t('dashboard.fleetState') %></h2>
    <%
      // Part-to-whole: one stacked bar, each segment keyed in the legend with its count.
      const parts = [
        { key: 'dashboard.fleetRentedNow', n: fleet.rented, cls: 'series-1' },
        { key: 'dashboard.fleetAvailable', n: fleet.available, cls: 'series-2' },
        { key: 'dashboard.fleetMaintenance', n: fleet.maintenance, cls: 'series-3' },
      ];
    %>
    <p class="fleet-total"><%= t('dashboard.fleetTotalCount', { n: fleet.total }) %></p>
    <div class="partbar" role="img" aria-label="<%= parts.map((p) => `${t(p.key)} ${p.n}`).join(', ') %>">
      <% parts.filter((p) => p.n > 0).forEach((p) => { %><span class="<%= p.cls %>" style="flex-grow: <%= p.n %>"></span><% }) %>
    </div>
    <ul class="legend partbar-legend">
      <% parts.forEach((p) => { %>
        <li><i class="key <%= p.cls %>"></i><%= t(p.key) %> <strong><%= p.n %></strong> <span class="muted">(<%= fmtPct(fleet.total ? p.n / fleet.total : 0) %>)</span></li>
      <% }) %>
    </ul>
    <p style="margin-top:16px;"><a href="/reports#fleet" class="btn ghost small"><%= t('dashboard.viewFullReport') %></a></p>
  </div>
</div>

<div class="card">
  <h2><%= t('dashboard.recentBookings') %></h2>
  <% if (recentBookings.length === 0) { %>
    <div class="empty"><p><%= t('dashboard.noBookings') %></p><a href="/bookings/new" class="btn"><%= t('dashboard.actionCreateBooking') %></a></div>
  <% } else { %>
  <div class="table-wrap">
    <table>
      <thead><tr><th><%= t('col.ref') %></th><th><%= t('col.customer') %></th><th><%= t('col.category') %></th><th><%= t('col.branch') %></th><th><%= t('col.pickup') %></th><th><%= t('col.returnExpected') %></th><th><%= t('col.status') %></th></tr></thead>
      <tbody>
        <% recentBookings.forEach(b => { %>
        <tr>
          <td>#<%= b.bookingid %></td>
          <td><%= b.customername %></td>
          <td><%= b.categoryname %></td>
          <td><%= b.branchname %></td>
          <td><%= new Date(b.pickupdate).toLocaleDateString(dateLocale) %></td>
          <td><%= new Date(b.returndateexpected).toLocaleDateString(dateLocale) %></td>
          <td>
            <% const statusColor = { Requested: 'grey', Confirmed: 'navy', CheckedOut: 'amber', Completed: 'green', Cancelled: 'red' }[b.bookingstatus] || 'grey'; %>
            <span class="badge <%= statusColor %>"><%= statusLabel('booking', b.bookingstatus) %></span>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
