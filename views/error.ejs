<div class="card empty-state">
  <h1><%= t('error.heading') %></h1>
  <p class="flash error" role="alert"><%= message %></p>
  <% if (detail) { %><p class="muted mono"><%= detail %></p><% } %>
  <p class="muted"><%= t('error.nextStep') %></p>
  <div class="form-actions">
    <a href="javascript:history.back()" class="btn ghost"><%= t('common.back') %></a>
    <a href="/" class="btn"><%= t('404.backHome') %></a>
  </div>
</div>
