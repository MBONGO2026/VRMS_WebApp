<div class="page-header">
  <div>
    <h1><%= t('bookings.list.title') %></h1>
    <p class="subtitle"><%= t('bookings.list.subtitle') %></p>
  </div>
  <a href="/bookings/new" class="btn"><%= t('bookings.list.new') %></a>
</div>

<div class="card">
  <% if (bookings.length === 0) { %>
    <div class="empty"><p><%= t('bookings.list.none') %></p><a href="/bookings/new" class="btn"><%= t('bookings.list.new') %></a></div>
  <% } else { %>
  <div class="table-wrap">
    <table>
      <thead><tr><th><%= t('col.ref') %></th><th><%= t('col.customer') %></th><th><%= t('col.category') %></th><th><%= t('col.branch') %></th><th><%= t('col.pickup') %></th><th><%= t('col.returnExpected') %></th><th><%= t('col.status') %></th><th><span class="visually-hidden"><%= t('common.actions') %></span></th></tr></thead>
      <tbody>
        <% bookings.forEach(b => { %>
        <tr>
          <td>#<%= b.bookingid %></td>
          <td><%= b.customername %></td>
          <td><%= b.categoryname %></td>
          <td><%= b.branchname %></td>
          <td><%= new Date(b.pickupdate).toLocaleDateString(dateLocale) %></td>
          <td><%= new Date(b.returndateexpected).toLocaleDateString(dateLocale) %></td>
          <td>
            <% const c = { Requested: 'grey', Confirmed: 'brand', CheckedOut: 'amber', Completed: 'green', Cancelled: 'red' }[b.bookingstatus] || 'grey'; %>
            <span class="badge <%= c %>"><%= statusLabel('booking', b.bookingstatus) %></span>
          </td>
          <td>
            <% if (b.bookingstatus === 'Requested') { %>
              <div class="row-actions">
                <a href="/bookings/<%= b.bookingid %>/confirm" class="btn small"><%= t('bookings.list.assignVehicle') %></a>
                <form method="POST" action="/bookings/<%= b.bookingid %>/cancel" data-confirm="<%= t('bookings.list.confirmCancel') %>">
                  <button type="submit" class="btn small danger" aria-label="<%= t('bookings.list.cancelBtn') %> #<%= b.bookingid %>"><%= t('bookings.list.cancelBtn') %></button>
                </form>
              </div>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>

<script>
  // Confirmation text comes from a data attribute, so quotes in translations cannot break the script.
  document.querySelectorAll('form[data-confirm]').forEach(function (f) {
    f.addEventListener('submit', function (e) { if (!window.confirm(f.dataset.confirm)) e.preventDefault(); });
  });
</script>
