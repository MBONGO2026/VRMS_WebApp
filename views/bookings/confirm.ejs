<div class="page-header">
  <div>
    <h1><%= t('bookings.confirm.title', { id: booking.bookingid }) %></h1>
    <p class="subtitle"><%= t('bookings.confirm.subtitle') %></p>
  </div>
</div>

<div class="grid cols-2">
  <div class="card">
    <h2><%= t('bookings.confirm.details') %></h2>
    <dl class="kv">
      <dt><%= t('col.customer') %></dt><dd><%= booking.customername %></dd>
      <dt><%= t('col.category') %></dt><dd><%= booking.categoryname %> (<%= fmtMoney(booking.dailyrate) %><%= t('common.perDay') %>)</dd>
      <dt><%= t('col.branch') %></dt><dd><%= booking.branchname %></dd>
      <dt><%= t('col.pickup') %></dt><dd><%= new Date(booking.pickupdate).toLocaleDateString(dateLocale) %></dd>
      <dt><%= t('col.returnExpected') %></dt><dd><%= new Date(booking.returndateexpected).toLocaleDateString(dateLocale) %></dd>
      <dt><%= t('bookings.confirm.priorRentals') %></dt><dd><%= booking.priorcompletedrentals %></dd>
    </dl>
    <% if (Number(booking.priorcompletedrentals) === 0) { %>
      <p class="flash info notice"><%- t('bookings.confirm.firstTimeWarning', { amount: fmtMoney(booking.depositamount) }) %></p>
    <% } else { %>
      <p class="flash success notice"><%= t('bookings.confirm.returningNote') %></p>
    <% } %>
  </div>

  <div class="card">
    <h2><%= t('bookings.confirm.assignVehicle') %></h2>
    <% if (error) { %><div class="flash error" role="alert"><%= error %></div><% } %>
    <% if (vehicles.length === 0) { %>
      <div class="empty"><p><%= t('bookings.confirm.noVehicles', { category: booking.categoryname }) %></p><a href="/vehicles" class="btn ghost"><%= t('bookings.confirm.seeVehicles') %></a></div>
    <% } else { %>
    <form class="stack" method="POST" action="/bookings/<%= booking.bookingid %>/confirm">
      <div class="field">
        <label for="vehicleId"><%= t('bookings.confirm.availableVehicle') %></label>
        <select id="vehicleId" name="vehicleId" required>
          <% vehicles.forEach(v => { %>
            <option value="<%= v.vehicleid %>"><%= v.registrationnumber %>, <%= v.make %> <%= v.model %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="staffId"><%= t('bookings.confirm.staff') %></label>
        <select id="staffId" name="staffId" required>
          <% staff.forEach(s => { %>
            <option value="<%= s.staffid %>"><%= s.fullname %> (<%= s.jobrole %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="deposit"><%= t('bookings.confirm.depositReceived') %></label>
        <input type="number" id="deposit" step="0.01" min="0" inputmode="decimal" name="deposit"
               value="<%= Number(booking.priorcompletedrentals) === 0 ? booking.depositamount : '0' %>">
      </div>
      <div class="form-actions">
        <button type="submit" class="btn"><%= t('bookings.confirm.confirmBtn') %></button>
        <a href="/bookings" class="btn ghost"><%= t('common.back') %></a>
      </div>
    </form>
    <% } %>
  </div>
</div>
