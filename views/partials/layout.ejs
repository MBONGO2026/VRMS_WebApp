<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' – VRMS SwiftDrive' : 'VRMS SwiftDrive' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <a class="skip-link" href="#main"><%= t('nav.skipToContent') %></a>
  <header class="topbar">
    <div class="brand">
      <strong>SwiftDrive VRMS</strong>
      <span><%= t('app.tagline') %></span>
    </div>
    <nav class="mainnav" aria-label="<%= t('nav.main') %>">
      <% [['/', 'nav.dashboard'], ['/customers', 'nav.customers'], ['/vehicles', 'nav.vehicles'], ['/bookings', 'nav.bookings'], ['/agreements', 'nav.agreements'], ['/reports', 'nav.reports']].forEach(([href, key]) => {
           const active = href === '/' ? currentPath === '/' : currentPath.startsWith(href); %>
        <a href="<%= href %>" class="<%= active ? 'active' : '' %>"<%- active ? ' aria-current="page"' : '' %>><%= t(key) %></a>
      <% }) %>
    </nav>
    <div class="langswitch" role="group" aria-label="<%= t('nav.language') %>">
      <a href="<%= langHref('fr') %>" lang="fr" class="<%= lang === 'fr' ? 'active' : '' %>"<%- lang === 'fr' ? ' aria-current="true"' : '' %>>FR</a>
      <a href="<%= langHref('en') %>" lang="en" class="<%= lang === 'en' ? 'active' : '' %>"<%- lang === 'en' ? ' aria-current="true"' : '' %>>EN</a>
    </div>
  </header>

  <main class="container" id="main" tabindex="-1">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="flash <%= flashType %>" role="<%= flashType === 'error' ? 'alert' : 'status' %>"><%= flash %></div>
    <% } %>
    <%- body %>
  </main>

  <footer class="appfooter">
    <%= t('app.footer') %>
  </footer>
</body>
</html>
