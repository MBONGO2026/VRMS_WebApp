<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' – VRMS SwiftDrive' : 'VRMS SwiftDrive' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="topbar">
    <div class="brand">
      <strong>SwiftDrive VRMS</strong>
      <span><%= t('app.tagline') %></span>
    </div>
    <nav class="mainnav">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>"><%= t('nav.dashboard') %></a>
      <a href="/customers" class="<%= currentPath.startsWith('/customers') ? 'active' : '' %>"><%= t('nav.customers') %></a>
      <a href="/vehicles" class="<%= currentPath.startsWith('/vehicles') ? 'active' : '' %>"><%= t('nav.vehicles') %></a>
      <a href="/bookings" class="<%= currentPath.startsWith('/bookings') ? 'active' : '' %>"><%= t('nav.bookings') %></a>
      <a href="/agreements" class="<%= currentPath.startsWith('/agreements') ? 'active' : '' %>"><%= t('nav.agreements') %></a>
      <a href="/reports" class="<%= currentPath.startsWith('/reports') ? 'active' : '' %>"><%= t('nav.reports') %></a>
    </nav>
    <div class="langswitch">
      <a href="<%= langHref('fr') %>" class="<%= lang === 'fr' ? 'active' : '' %>">FR</a>
      <a href="<%= langHref('en') %>" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
    </div>
  </header>

  <div class="container">
    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="flash <%= flashType %>"><%= flash %></div>
    <% } %>
    <%- body %>
  </div>

  <footer class="appfooter">
    <%= t('app.footer') %>
  </footer>
</body>
</html>
